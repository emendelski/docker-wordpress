# Copy to .env and adjust. Every value has a default in compose.yaml, so .env
# is optional.

# Database (applied when the db_data volume is first created)
DB_NAME=wordpress
DB_USER=wordpress
DB_PASSWORD=wordpress
DB_ROOT_PASSWORD=docker

# WordPress
# Leave WORDPRESS_DEBUG empty to disable it; any non-empty value, including
# "false", enables it.
WORDPRESS_DEBUG=1
# local, development, staging or production
WP_ENVIRONMENT_TYPE=local

# Xdebug mode: debug (default), off, develop, profile, coverage or trace
XDEBUG_MODE=debug

# Host ports. They listen on 127.0.0.1 only, so the database, phpMyAdmin and
# Mailpit are not reachable from the local network; set BIND_ADDRESS=0.0.0.0
# to open them up (e.g. to test from a phone).
BIND_ADDRESS=127.0.0.1
WP_PORT=8080
DB_PORT=3308
PMA_PORT=8181
MAILPIT_PORT=8025
MAILPIT_SMTP_PORT=1025
