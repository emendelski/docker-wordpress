# Copy to .env and adjust. Every value has a default in compose.yaml, so .env
# is optional.

# Database (applied when the db_data volume is first created)
DB_NAME=wordpress
DB_USER=wordpress
DB_PASSWORD=wordpress
DB_ROOT_PASSWORD=docker

# Host ports
DB_PORT=3308

# Xdebug mode: debug (default), off, develop, profile, coverage, trace
XDEBUG_MODE=debug
MAILPIT_PORT=8025
MAILPIT_SMTP_PORT=1025
PMA_PORT=8181
